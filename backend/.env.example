# --- infra ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sesac
REDIS_URL=redis://localhost:6379/0

# --- JWT (직접 생성, 카카오와 무관) ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- 카카오 로그인: https://developers.kakao.com 앱 > 카카오 로그인 ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/auth/kakao/callback
FRONTEND_BASE_URL=http://localhost:3000

# --- F-01 한국투자증권(KIS) Open API: https://apiportal.koreainvestment.com ---
KIS_APP_KEY=
KIS_APP_SECRET=

# --- F-03-2 DART 공시 재무데이터: https://opendart.fss.or.kr ---
DART_API_KEY=

# --- F-03/F-05 LLM(뉴스 분류·투자판단·자막 등): https://platform.openai.com ---
OPENAI_API_KEY=

# --- F-02 숏폼 배경 영상 저장용 S3 (ISSUE-E3) ---
# 버킷에 {종목명}_positive.mp4 / {종목명}_negative.mp4 로 미리 업로드돼 있어야 함 (예: 삼성전자_positive.mp4)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
# 로컬에서 실 AWS 없이 테스트할 때만 채우기 (예: MinIO). 실 AWS 쓰면 비워둘 것
AWS_S3_ENDPOINT_URL=

# --- F-04, 보류 중. 재개 시 https://core.telegram.org/bots#botfather 에서 발급 ---
TELEGRAM_BOT_TOKEN=
