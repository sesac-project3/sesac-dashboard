# --- infra ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sesac
REDIS_URL=redis://localhost:6379/0

# --- 환경 구분 ---
# 로컬 docker-compose로 개발 중이면 비워두거나 development로. 배포 환경에서만 production으로
# 설정 — KIS 인증값(access_token/approval_key)을 .env 대신 Redis에서 관리하게 바뀐다.
APP_ENV=development

# --- JWT (직접 생성, 카카오와 무관) ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- 카카오 로그인: https://developers.kakao.com 앱 > 카카오 로그인 ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/auth/kakao/callback
FRONTEND_BASE_URL=http://localhost:3000

# --- F-01 한국투자증권(KIS) Open API: https://apiportal.koreainvestment.com ---
KIS_APP_KEY=
KIS_APP_SECRET=
# 개발 환경 전용 재사용 캐시 — 서버 로그에 "[KIS] New access token issued." 같은 메시지와
# 함께 아래 형식으로 값이 출력되면, 그대로 복사해서 채워두면 다음 서버 재시작부터
# KIS에 새로 발급받지 않고 재사용한다(KIS 토큰 발급은 분당 1회 제한이라 --reload로
# 서버가 자주 재시작되면 자칫 이 제한에 걸린다). 배포 환경에서는 안 쓰임(Redis로 관리).
KIS_ACCESS_TOKEN=
KIS_ACCESS_TOKEN_EXPIRES_AT=
KIS_WS_APPROVAL_KEY=
KIS_WS_APPROVAL_KEY_EXPIRES_AT=

# --- F-03-2 DART 공시 재무데이터: https://opendart.fss.or.kr ---
DART_API_KEY=

# --- F-03/F-05 LLM(뉴스 분류·투자판단·자막 등): https://platform.openai.com ---
OPENAI_API_KEY=

# --- F-02 숏폼 배경 영상 저장용 S3 (ISSUE-E3) ---
# 버킷에 {종목명}_positive.mp4 / {종목명}_negative.mp4 로 미리 업로드돼 있어야 함 (예: 삼성전자_positive.mp4)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
# 로컬에서 실 AWS 없이 테스트할 때만 채우기 (예: MinIO). 실 AWS 쓰면 비워둘 것
AWS_S3_ENDPOINT_URL=

# --- F-04, 보류 중. 재개 시 https://core.telegram.org/bots#botfather 에서 발급 ---
TELEGRAM_BOT_TOKEN=
